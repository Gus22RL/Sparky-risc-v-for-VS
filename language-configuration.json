{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "(-?0[xX][0-9a-fA-F]+)|(-?\\d*\\.\\d+)|([A-Za-z_.$][A-Za-z0-9_.$]*)|(-?\\d+)",
  "folding": {
    "markers": {
      "start": "^\\s*(?:\\.macro\\b|(?:[A-Za-z_.$][A-Za-z0-9_.$]*:\\s*)?#\\s*fn\\b)",
      "end": "^\\s*(?:\\.end_macro\\b|#\\s*endfn\\b)"
    }
  }
}
